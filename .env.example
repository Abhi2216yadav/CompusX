# CampusX Firebase configuration
# Copy this file to `.env.local` and fill in the values from
# Firebase Console -> Project settings -> Your apps -> SDK setup.
#
# If these values are missing, CampusX automatically starts in
# DEMO MODE: every feature still works, but data is stored in your
# browser's localStorage instead of Cloud Firestore. See README.md.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: pre-select a school when running multi-tenant.
# VITE_DEFAULT_SCHOOL_ID=abc-public-school

# ---------------------------------------------------------------------------
# Firestore seed (server-side)
# ---------------------------------------------------------------------------
# To seed Cloud Firestore with the same demo data, create a service account
# and run `npm run seed`:
#
#   GOOGLE_APPLICATION_CREDENTIALS="C:\path\to\service-account.json"
#   npm run seed
#
# Or inline the JSON:
#
#   FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
#   npm run seed
#
# Dry-run: npm run seed:dry
#
# Composite indexes
# ---------------------------------------------------------------------------
# CampusX needs composite indexes for the ordered leaderboard and analytics
# queries. Deploy them from the repository root with:
#
#   firebase deploy --only firestore:rules,firestore:indexes,storage
#
# See README.md -> "Required Firestore indexes".